# Never commit secrets
.streamlit/secrets.toml
*.env
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Atomic-write temp files
*.tmp

# Runtime validation outputs — recreated only by their own run mode.
# Keeping these out of git prevents mock/real rows from ever being mixed at
# the VCS level. Real-mode GitHub auto-save still pushes them via the
# Contents API independently of local tracking.
/data/validated_vehicle_variants_full_gemini31_v1.json
/data/validated_vehicle_variants_full_gemini31_v1.checkpoint.json
/data/validation_run_summary_gemini31.json
/data/upload_readiness_report.json
/data/mock/

# Legacy generated outputs from the retired Gemini/guard/repair pipeline.
# These must never be used as source data for the new GPT-5.4 catalog.
/data/_legacy_archive/
/data/validation_run_summary*.json
/data/checkpoint/
/data/gemini/
/data/guard/
/data/repair/
/data/clean_catalog/
/data/review_queue/
/data/configurable_group/

# New single-GPT-5.4 model technical-catalog outputs (regenerated by
# scripts/run_model_catalog.py). Not committed: the website-ready file needs a
# grounded GPT-5.4 run, and the offline stub is review-only.
/data/model_technical_catalog_il.json
/data/model_technical_catalog_il_readiness.json
/data/model_technical_catalog_il_review.json
