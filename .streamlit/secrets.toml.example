# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit the real secrets.toml — it is git-ignored.

# ---------------------------------------------------------------------------
# Required secrets for the GPT-5.4 model technical catalog (use these names).
# Environment variables of the same name take precedence over these values.
# ---------------------------------------------------------------------------

# Required for real GPT-5.4 grounded catalog runs.
OPENAI_API_KEY = ""

# Required for GitHub checkpoint pushes (model-profile level).
GITHUB_TOKEN = ""

# ---------------------------------------------------------------------------
# Optional catalog settings.
# ---------------------------------------------------------------------------

[catalog]
single_gpt54_model_catalog_mode = true
github_checkpoint_enabled = false
push_every_profiles = 1
strict_github_checkpoint = false

# ---------------------------------------------------------------------------
# Optional GitHub repo/branch overrides (auto-detected from the git remote /
# env if omitted). NOTE: the push token is GITHUB_TOKEN above — not here.
# ---------------------------------------------------------------------------

[github]
# repo = "owner/repo"
# branch = "branch-name"
# token = ""   # backward-compatible alias only; prefer top-level GITHUB_TOKEN

# ---------------------------------------------------------------------------
# Legacy (retired) Gemini validation engine — kept for reference only.
# ---------------------------------------------------------------------------

[google]
api_key = ""
gemini_validator_model_id = "gemini-3.1-pro-preview"
grounding_enabled = true
