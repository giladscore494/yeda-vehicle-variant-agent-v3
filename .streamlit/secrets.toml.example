# Example Streamlit secrets layout for the validation runner.
# Copy to .streamlit/secrets.toml (NEVER commit the real file — it is
# gitignored) or configure the same keys in Streamlit Cloud "Secrets".
#
# Both layouts below are supported; [github] wins over [google] for GitHub
# settings when both are present.

[google]
api_key = ""                                        # Gemini API key
gemini_validator_model_id = "gemini-3.1-pro-preview"
grounding_enabled = true
# GitHub settings may also live here (legacy layout):
token = ""                                          # GitHub push token
repo_full_name = "giladscore494/yeda-vehicle-variant-agent-v3"
target_branch = "validation-v2-budgeted-dual-il-trims"
base_branch = "main"

# Optional cleaner layout:
# [github]
# token = ""
# repo_full_name = "giladscore494/yeda-vehicle-variant-agent-v3"
# target_branch = "validation-v2-budgeted-dual-il-trims"
# base_branch = "main"
